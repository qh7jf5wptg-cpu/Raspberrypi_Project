[Unit]
Description=PickLine soft PLC
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/pi/PickLine
Environment=MQTT_BROKER=192.168.50.1
ExecStart=/usr/bin/python3 plc/pickline_plc.py
Restart=always
RestartSec=3
StandardOutput=append:/home/pi/PickLine/plc.log
StandardError=append:/home/pi/PickLine/plc.log

[Install]
WantedBy=multi-user.target
