<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kjde.pi-nat</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/pi-nat.sh</string>
    </array>

    <!-- run once at boot, then re-check every 60 seconds -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/var/log/pi-nat.out</string>
    <key>StandardErrorPath</key>
    <string>/var/log/pi-nat.err</string>
</dict>
</plist>
